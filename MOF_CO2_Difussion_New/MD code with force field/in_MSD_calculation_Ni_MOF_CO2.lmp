 

# -------- Initialization --------
units           real
dimension       3
boundary        p    p    p
atom_style      full

 
read_restart      restart.4000000.equil

 
bond_style      harmonic
angle_style     harmonic
bond_coeff      1   0.0   1.16     # C-O, K=0
angle_coeff     1   0.0   180.0    # O-C-O, K=0

# -------- Pair style / long-range electrostatics --------
pair_style      lj/cut/coul/long 12.5
kspace_style    pppm 1e-5
 

special_bonds   lj/coul 0.0 0.0 1.0    


#------------------- LJ parameters ---------------------

# pair_coeff 1 1   0.015000        2.524807  # Ni4+2 Ni4+2
# pair_coeff 2 2   0.069000        3.260689  # N_3 N_3
# pair_coeff 3 3   0.044000        2.571134  # H_ H_
# pair_coeff 4 4   0.044000        2.571134  # H_ H_
# pair_coeff 5 5   0.105000        3.430851  # C_R C_R
# pair_coeff 6 6   0.105000        3.430851  # C_R C_R
# pair_coeff 7 7   0.105000        3.430851  # C_R C_R

pair_coeff 1 1   0.0         2.524807  # Ni4+2 Ni4+2
pair_coeff 2 2   0.0         3.260689  # N_3 N_3
pair_coeff 3 3   0.0         2.571134  # H_ H_
pair_coeff 4 4   0.0         2.571134  # H_ H_
pair_coeff 5 5   0.0         3.430851  # C_R C_R
pair_coeff 6 6   0.0        3.430851  # C_R C_R
pair_coeff 7 7   0.0         3.430851  # C_R C_R
pair_coeff 8 8   0.05366         2.80      # C1 (CO2)
pair_coeff 9 9   0.15698         3.05      # O (CO2)


# pair_coeff 1 2   0.032171        2.892748  # Ni4+2 N_3
# pair_coeff 1 3   0.025690        2.547971  # Ni4+2 H_
# pair_coeff 1 4   0.025690        2.547971  # Ni4+2 H_
# pair_coeff 1 5   0.039686        2.977829  # Ni4+2 C_R
# pair_coeff 1 6   0.039686        2.977829  # Ni4+2 C_R
# pair_coeff 1 7   0.039686        2.977829  # Ni4+2 C_R




pair_coeff 1 2   0.0         2.892748  # Ni4+2 N_3
pair_coeff 1 3   0.0         2.547971  # Ni4+2 H_
pair_coeff 1 4   0.0         2.547971  # Ni4+2 H_
pair_coeff 1 5   0.0         2.977829  # Ni4+2 C_R
pair_coeff 1 6   0.0         2.977829  # Ni4+2 C_R
pair_coeff 1 7   0.0         2.977829  # Ni4+2 C_R
pair_coeff 1 8   0.028371        2.662404  # Ni4+2 C1(CO2)
pair_coeff 1 9   0.048525        2.787404  # Ni4+2 O(CO2)


# pair_coeff 2 3   0.055100        2.915912  # N_3 H_
# pair_coeff 2 4   0.055100        2.915912  # N_3 H_
# pair_coeff 2 5   0.085117        3.345770  # N_3 C_R
# pair_coeff 2 6   0.085117        3.345770  # N_3 C_R
# pair_coeff 2 7   0.085117        3.345770  # N_3 C_R




pair_coeff 2 3   0.0         2.915912  # N_3 H_
pair_coeff 2 4   0.0         2.915912  # N_3 H_
pair_coeff 2 5   0.0         3.345770  # N_3 C_R
pair_coeff 2 6   0.0         3.345770  # N_3 C_R
pair_coeff 2 7   0.0         3.345770  # N_3 C_R
pair_coeff 2 8   0.060848        3.030345  # N_3 C1(CO2)
pair_coeff 2 9   0.104074        3.155345  # N_3 O(CO2)


# pair_coeff 3 4   0.044000        2.571134  # H_ H_
# pair_coeff 3 5   0.067971        3.000993  # H_ C_R
# pair_coeff 3 6   0.067971        3.000993  # H_ C_R
# pair_coeff 3 7   0.067971        3.000993  # H_ C_R


pair_coeff 3 4   0.0         2.571134  # H_ H_
pair_coeff 3 5   0.0         3.000993  # H_ C_R
pair_coeff 3 6   0.0         3.000993  # H_ C_R
pair_coeff 3 7   0.0         3.000993  # H_ C_R
pair_coeff 3 8   0.048591        2.685567  # H_ C1(CO2)
pair_coeff 3 9   0.083109        2.810567  # H_ O(CO2)


# pair_coeff 4 5   0.067971        3.000993  # H_ C_R
# pair_coeff 4 6   0.067971        3.000993  # H_ C_R
# pair_coeff 4 7   0.067971        3.000993  # H_ C_R



pair_coeff 4 5   0.0         3.000993  # H_ C_R
pair_coeff 4 6   0.0         3.000993  # H_ C_R
pair_coeff 4 7   0.0         3.000993  # H_ C_R
pair_coeff 4 8   0.048591        2.685567  # H_ C1(CO2)
pair_coeff 4 9   0.083109        2.810567  # H_ O(CO2)

# pair_coeff 5 6   0.105000        3.430851  # C_R C_R
# pair_coeff 5 7   0.105000        3.430851  # C_R C_R



pair_coeff 5 6   0.0         3.430851  # C_R C_R
pair_coeff 5 7   0.0         3.430851  # C_R C_R
pair_coeff 5 8   0.075062        3.115426  # C_R C1(CO2)
pair_coeff 5 9   0.128387        3.240426  # C_R O(CO2)


# pair_coeff 6 7   0.105000        3.430851  # C_R C_R


pair_coeff 6 7   0.0         3.430851  # C_R C_R
pair_coeff 6 8   0.075062        3.115426  # C_R C1(CO2)
pair_coeff 6 9   0.128387        3.240426  # C_R O(CO2)

pair_coeff 7 8   0.075062        3.115426  # C_R C1(CO2)
pair_coeff 7 9   0.128387        3.240426  # C_R O(CO2)

pair_coeff 8 9   0.091785        2.925000  # C1(CO2) O(CO2)

# --------- Neighbor settings-------------------------------
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

#----------Groups-------------
group MOF type 1 2 3 4 5 6 7
group CO2 type 8 9
group CO2_C type 8 

restart         100000 msd_restart.*

#----------Freeze the MOF (rigid-framework study) -------------
velocity MOF set 0.0 0.0 0.0
fix MOF_force MOF setforce 0.0 0.0 0.0


# -------- CO2 stays on the same rigid-body NVE integrator --------
fix 2 CO2 rigid/nve/small molecule


# ============================================================================
# Data-gathering run for MSD
# reset_timestep 0 makes this moment t=0, the reference configuration
# ============================================================================
reset_timestep  0

compute CO2temp CO2 temp


compute msd_co2 CO2_C msd com yes

variable twopoint  equal c_msd_co2[4]/6/(step*dt+1.0e-6)
fix 9 all vector 1000 c_msd_co2[4]
variable fitslope  equal slope(f_9)/6/(1000*dt)


thermo          1000
thermo_style    custom step temp c_CO2temp c_msd_co2[1] c_msd_co2[2] c_msd_co2[3] c_msd_co2[4] v_twopoint v_fitslope

# raw MSD-vs-time data, saved for the final fit in Python
fix msd_out CO2_C ave/time 1000 1 1000 c_msd_co2[1] c_msd_co2[2] c_msd_co2[3] c_msd_co2[4] file msd_co2.dat

timestep        0.5
run             4000000        # match or exceed your production run length

write_restart   restart.msd_final.equil


